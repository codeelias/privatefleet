{
  "name": "@privatefleet/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && echo \"api: types OK\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "tsx src/db/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@node-rs/argon2": "^2.2.2",
    "@privatefleet/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.0",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@privatefleet/eslint-config": "workspace:*",
    "@privatefleet/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
