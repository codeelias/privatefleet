# API environment (copy to apps/api/.env for local use).
# Demo mode (Phase 1) needs none of these - just run `pnpm dev`.

# --- Engine selection ---
# demo     -> in-memory DemoStore (the Honey Pot demo)
# postgres -> Drizzle repositories + RLS (Phase 2)
REPOSITORY_MODE=demo

# --- Postgres mode (Phase 2) ---
# Runtime role: NON-OWNER so RLS is enforced (created by scripts/db-setup.sql).
DATABASE_URL=postgres://privatefleet_app:privatefleet_app_pw@127.0.0.1:5432/privatefleet_dev
# Migrator role (owner): used only by `pnpm db:migrate` / `pnpm db:seed`.
MIGRATION_DATABASE_URL=postgres://privatefleet:privatefleet_dev_pw@127.0.0.1:5432/privatefleet_dev
# Minimum 16 chars; use a real secret outside local dev.
AUTH_JWT_SECRET=local-dev-only-change-me-please
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30

# --- Server ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
