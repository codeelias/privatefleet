# Map provider configuration (all optional - key-free defaults apply).
# See apps/web/src/features/live-map/map-config.ts and ADR-0010.

# Preferred engine when the page loads: vector (default, MapLibre GL) or
# raster (CARTO fallback, no WebGL). Overridable per-session with
# ?map=vector|raster.
# VITE_MAP_ENGINE=vector

# --- Raster engine (Leaflet fallback) ---
# Primary tile template. Default: CARTO light (free, keyless).
# OpenFreeMap serves vector tiles only; its /planet/*.png returns empty.
# VITE_MAP_RASTER_TILES=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# VITE_MAP_RASTER_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
# VITE_MAP_RASTER_NAME=CARTO light

# --- Vector engine (MapLibre) ---
# Primary style JSON, then optional comma-separated retry chain.
# Default chain: MapTiler (when a key exists) -> OpenFreeMap bright -> liberty.
# VITE_MAP_VECTOR_STYLE=https://tiles.openfreemap.org/styles/bright
# VITE_MAP_VECTOR_STYLE_NAME=OpenFreeMap bright
# VITE_MAP_VECTOR_FALLBACKS=https://tiles.openfreemap.org/styles/liberty

# --- Optional MapTiler key ---
# Enables MapTiler basic defaults for both engines. The app validates the
# key before use and falls back automatically if it is rejected.
# VITE_MAPTILER_KEY=
